---
interface Props {
  title?: string;
}

const { title = '注记' } = Astro.props;
---

<aside class="note" aria-label={title}>
  <strong>{title}</strong>
  <div><slot /></div>
</aside>

<style>
  .note {
    margin-block: 1.75rem;
    padding: 1rem 1.125rem;
    border-inline-start: 4px solid var(--read-accent);
    background: var(--read-code);
  }

  strong {
    display: block;
    margin-block-end: 0.375rem;
    color: var(--read-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  strong::before {
    color: var(--read-accent);
    content: '// ';
  }

  :global(.note p) {
    margin: 0;
  }
</style>
