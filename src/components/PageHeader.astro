---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-heading narrow-shell">
  {eyebrow && <p class="kicker">// {eyebrow}</p>}
  <h1><span class="glitch" data-text={title}>{title}</span></h1>
  <div class="lede">{description}</div>
  <div class="hazard" aria-hidden="true"></div>
</header>

<style>
  .page-heading {
    padding-block: 0.75rem 2rem;
  }

  h1 {
    margin-block-start: 0.35rem;
    color: var(--stage-heading);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-style: italic;
    line-height: 1.05;
  }

  .lede {
    max-width: 38rem;
    margin-block: 0.875rem 1.75rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .hazard {
    width: 9rem;
  }

  @media (max-width: 44rem) {
    .page-heading {
      padding-block: 0.5rem 1.5rem;
    }
  }
</style>
