---
import { getCollection } from 'astro:content';

import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/content';

const posts = getPublishedPosts(await getCollection('posts'));
const tags = getTagCounts(posts);
---

<BaseLayout title="标签" description="按主题找文章：点选标签查看对应文章。">
  <PageHeader eyebrow={`共 ${tags.length} 个标签`} title="标签" description="按主题找文章：点选标签查看对应文章。" />
  <ul class="tag-cloud narrow-shell">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${encodeURIComponent(tag.name)}/`}>
            <span>{tag.name}</span>
            <small>{tag.count} 篇</small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .tag-cloud {
    display: grid;
    margin-block: 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
  }

  a {
    display: flex;
    padding: 0.875rem 1rem;
    justify-content: space-between;
    color: var(--panel-title);
    background: #0a0a0f;
    font-weight: 650;
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
  }

  :global([data-theme='dark']) a { border: 1px solid var(--panel-line); clip-path: none; }

  a:hover { color: #0a0a0f; background: var(--yellow); }

  span::before {
    color: var(--red);
    font-family: var(--font-mono);
    content: '# ';
  }

  small {
    color: var(--cyan);
    font-family: var(--font-mono);
  }

  a:hover small, a:hover span::before { color: inherit; }

  @media (max-width: 36rem) {
    .tag-cloud { grid-template-columns: 1fr; }
  }
</style>
