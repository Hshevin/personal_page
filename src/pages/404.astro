---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在，或者已经搬走了。">
  <section class="not-found narrow-shell">
    <p class="kicker">// ERROR 404 · 信号丢失</p>
    <h1><span class="glitch" data-text="这一页不存在">这一页不存在</span></h1>
    <p class="lede">地址可能打错了，或者内容已经搬走。试试从首页重新出发，或者搜一下。</p>
    <div class="actions">
      <a class="go-link" href="/">返回首页</a>
      <a class="go-link" href="/search">去搜索</a>
    </div>
    <div class="hazard" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 24rem;
    padding-block: 2.5rem;
    align-content: center;
  }

  h1 {
    margin-block-start: 0.5rem;
    color: var(--stage-heading);
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-style: italic;
    line-height: 1.05;
  }

  .lede {
    max-width: 32rem;
    margin-block-start: 1rem;
    font-weight: 500;
  }

  .actions {
    display: flex;
    margin-block: 2rem;
    gap: 0.75rem;
  }

  .hazard { width: 12rem; }
</style>
