---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在或已经移动。">
  <section class="not-found narrow-shell">
    <p>404 · Not found</p>
    <h1>这一页还没有被写下。</h1>
    <div>你访问的地址不存在，或者内容已经移动到了别处。</div>
    <a href="/">返回首页 →</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 34rem;
    padding-block: 5rem;
    align-content: center;
  }

  p {
    color: var(--warm);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 38rem;
    margin-block-start: 0.75rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.045em;
  }

  div {
    margin-block-start: 1rem;
    color: var(--text-muted);
  }

  a {
    width: max-content;
    margin-block-start: 2rem;
    color: var(--accent-strong);
    font-weight: 650;
    text-decoration: none;
  }
</style>
