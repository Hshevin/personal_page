---
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="在文章、项目和关于页里找内容。">
  <div data-pagefind-ignore>
    <PageHeader eyebrow="检索" title="搜索" description="在文章和页面里找内容。用电脑访问时，任何页面按 / 或 ⌘K 都能直接打开。" />
    <section class="search-shell panel narrow-shell" aria-labelledby="search-label">
      <label class="panel-label" id="search-label" for="search-input">关键词</label>
      <div class="search-field">
        <input id="search-input" type="search" autocomplete="off" placeholder="输入标题、标签或关键词" />
        <kbd aria-hidden="true">/</kbd>
      </div>
      <p class="search-status" id="search-status" role="status" aria-live="polite">输入关键词，结果会马上出现。</p>
      <ol class="search-results" id="search-results"></ol>
    </section>
  </div>
</BaseLayout>

<!-- Pagefind is generated after Astro builds, so this native module must not be rewritten by Vite. -->
<script is:inline type="module">
  const input = document.querySelector('#search-input');
  const results = document.querySelector('#search-results');
  const status = document.querySelector('#search-status');
  let pagefind;

  const setStatus = (message) => {
    if (status) status.textContent = message;
  };

  const loadPagefind = async () => {
    if (pagefind) return pagefind;

    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    } catch {
      setStatus('搜索暂时不可用，请稍后再试。');
      return undefined;
    }
  };

  const renderResults = async (term) => {
    if (!results) return;
    results.replaceChildren();

    if (!term.trim()) {
      setStatus('输入关键词，结果会马上出现。');
      return;
    }

    setStatus('正在搜索……');
    const search = await loadPagefind();
    const response = await search?.debouncedSearch(term.trim());
    if (!response) return;

    const total = response.results.length;
    const entries = await Promise.all(response.results.slice(0, 12).map((result) => result.data()));
    setStatus(
      total === 0
        ? '没有找到相关内容，换个关键词试试。'
        : total > entries.length
          ? `找到 ${total} 条结果，先显示最相关的 ${entries.length} 条。`
          : `找到 ${total} 条结果。`,
    );

    for (const entry of entries) {
      const item = document.createElement('li');
      const link = document.createElement('a');
      const title = document.createElement('h2');
      const excerpt = document.createElement('p');

      link.href = entry.url;
      title.textContent = entry.meta.title ?? '未命名页面';
      excerpt.textContent = entry.plain_excerpt;
      link.append(title, excerpt);
      item.append(link);
      results.append(item);
    }
  };

  input?.addEventListener('focus', () => void loadPagefind(), { once: true });
  input?.addEventListener('input', () => {
    const term = input.value;
    const url = new URL(window.location.href);
    term ? url.searchParams.set('q', term) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
    void renderResults(term);
  });

  const initialQuery = new URL(window.location.href).searchParams.get('q');
  if (initialQuery && input) {
    input.value = initialQuery;
    void renderResults(initialQuery);
  }
  input?.focus();
</script>

<style>
  .search-field {
    position: relative;
  }

  .search-field::before {
    position: absolute;
    top: 50%;
    left: 0.9rem;
    transform: translateY(-50%);
    color: var(--yellow);
    font-family: var(--font-mono);
    font-weight: 700;
    content: '>';
    pointer-events: none;
  }

  input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 3.5rem 0.75rem 2.1rem;
    border: 1px solid var(--panel-line);
    border-radius: 0;
    color: var(--panel-title);
    background: var(--panel-raised);
    font: inherit;
    font-family: var(--font-mono);
  }

  input::placeholder {
    color: var(--panel-muted);
  }

  input:focus {
    border-color: var(--yellow);
    outline: none;
    box-shadow: 0 0 0 1px var(--yellow);
  }

  kbd {
    position: absolute;
    top: 50%;
    right: 0.875rem;
    padding: 0 0.45rem;
    transform: translateY(-50%);
    border: 1px solid var(--panel-line);
    color: var(--panel-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (hover: none) {
    kbd {
      display: none;
    }
  }

  .search-status {
    margin-block: 1rem;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .search-results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-results :global(li + li) {
    border-block-start: 1px dashed var(--panel-line);
  }

  .search-results :global(a) {
    display: block;
    padding: 0.875rem 0.75rem;
    border-inline-start: 2px solid transparent;
    text-decoration: none;
  }

  .search-results :global(a:hover) {
    border-inline-start-color: var(--yellow);
    background: var(--panel-raised);
  }

  .search-results :global(h2) {
    color: var(--panel-title);
    font-family: inherit;
    font-size: 1.05rem;
  }

  .search-results :global(p) {
    margin-block-start: 0.3rem;
    color: var(--panel-muted);
    font-size: 0.875rem;
  }
</style>
