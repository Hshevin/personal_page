---
import { getCollection } from 'astro:content';

import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';

const [profile] = await getCollection('profile');
const posts = getPublishedPosts(await getCollection('posts'));
const projects = (await getCollection('projects')).toSorted(
  (left, right) => right.data.order - left.data.order,
);
const friends = (await getCollection('links')).toSorted(
  (left, right) => right.data.order - left.data.order,
);
const featuredPosts = posts.filter(({ data }) => data.featured).slice(0, 4);
const visiblePosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 4);
const featuredProjects = projects.filter(({ data }) => data.featured).slice(0, 2);
const visibleProjects = featuredProjects.length > 0 ? featuredProjects : projects.slice(0, 2);
const firstYear = posts.at(-1)?.data.publishedAt.getFullYear();
const pad = (value: number) => String(value).padStart(2, '0');

const stats = [
  { label: '文章', value: pad(posts.length) },
  ...(projects.length > 0 ? [{ label: '项目', value: pad(projects.length) }] : []),
  { label: '友链', value: pad(friends.length) },
  ...(firstYear ? [{ label: '记录始于', value: String(firstYear) }] : []),
];

const sections = ['posts', ...(visibleProjects.length > 0 ? ['projects'] : []), 'skills', ...(friends.length > 0 ? ['friends'] : [])];
const sectionNumber = (id: string) => `[${pad(sections.indexOf(id) + 1)}]`;
---

<BaseLayout title={profile.data.name} description={profile.data.tagline}>
  <section class="hero page-shell" aria-labelledby="profile-name">
    <div class="hero-copy">
      <p class="kicker">// {profile.data.tagline}</p>
      <h1 id="profile-name">
        <span class="glitch" data-text={profile.data.name}>{profile.data.name}</span>
      </h1>
      <div class="bio">
        {profile.data.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="hero-actions">
        <a class="go-link" href="/blog">读文章 <Icon name="arrow" size={16} /></a>
        {
          profile.data.socials.map((social) => (
            <a class="plain-link" href={social.url} target="_blank" rel="me noopener noreferrer">
              {social.label === 'GitHub' && <Icon name="github" size={16} />}
              {social.label}
            </a>
          ))
        }
        <a class="plain-link" href="/about">关于我</a>
      </div>
    </div>

    <aside class="id-card" aria-label="站点概况">
      <div class="id-photo">
        <img src={profile.data.avatar} alt={`${profile.data.name} 的头像`} width="160" height="160" />
      </div>
      <p class="id-name mono"><span>ID</span>{profile.data.name.toUpperCase()}</p>
      <dl class="id-stats mono">
        {
          stats.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      {profile.data.location && <p class="id-location mono"><Icon name="map" size={14} />{profile.data.location}</p>}
      <div class="barcode" aria-hidden="true"></div>
    </aside>
  </section>

  <div class="home-grid page-shell">
    <section class="panel wide" aria-labelledby="posts-heading">
      <div class="panel-label">
        <h2 id="posts-heading"><span aria-hidden="true">{sectionNumber('posts')} </span>近期文章</h2>
        <a href="/blog">全部文章 →</a>
      </div>
      <PostList posts={visiblePosts} />
    </section>

    {
      visibleProjects.length > 0 && (
        <section class="panel panel-yellow wide" aria-labelledby="projects-heading">
          <div class="panel-label">
        <h2 id="projects-heading"><span aria-hidden="true">{sectionNumber('projects')} </span>项目</h2>
        <a href="/projects">全部项目 →</a>
      </div>
          <div class="project-preview">
            {visibleProjects.map((project) => (
              <article>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <ul class="chip-list" aria-label="技术栈">
                  {project.data.stack.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="panel panel-red" aria-labelledby="skills-heading">
      <div class="panel-label">
        <h2 id="skills-heading"><span aria-hidden="true">{sectionNumber('skills')} </span>在学在用</h2>
      </div>
      <div class="skills">
        {
          profile.data.skills.map((group, index) => (
            <section>
              <h3>{group.category}</h3>
              <ul class="chip-list" style={index % 2 === 1 ? '--chip: var(--yellow)' : undefined}>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    {
      friends.length > 0 && (
        <section class="panel panel-yellow" aria-labelledby="friends-heading">
          <div class="panel-label">
        <h2 id="friends-heading"><span aria-hidden="true">{sectionNumber('friends')} </span>朋友们</h2>
        <a href="/links">全部友链 →</a>
      </div>
          <ul class="friend-list">
            {friends.slice(0, 4).map((friend) => (
              <li>
                <a href={friend.data.url} target="_blank" rel="noopener noreferrer">
                  <span>{friend.data.name}</span>
                  <Icon name="external" size={14} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    padding-block: 1.5rem 2.5rem;
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: center;
    gap: 3rem;
  }

  h1 {
    margin-block-start: 0.5rem;
    color: var(--stage-heading);
    font-size: clamp(2.5rem, 9.5vw, 7rem);
    font-style: italic;
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .bio {
    max-width: 34rem;
    margin-block-start: 1.25rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .bio p + p { margin-block-start: 0.6rem; }

  .hero-actions {
    display: flex;
    margin-block-start: 1.75rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .plain-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .plain-link:hover { color: var(--yellow); }

  .id-card {
    padding: 0.875rem;
    border: 1px solid rgba(243, 230, 0, 0.4);
    color: var(--yellow);
    background: var(--panel);
  }

  .id-photo {
    position: relative;
    aspect-ratio: 1;
    padding: 0.4rem;
    background: linear-gradient(150deg, #ff003c, #6b0019);
  }

  .id-photo::after {
    position: absolute;
    inset: 0.4rem;
    border: 1px solid rgba(243, 230, 0, 0.55);
    content: '';
    pointer-events: none;
  }

  .id-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .id-name {
    display: flex;
    margin-block-start: 0.75rem;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .id-name span { color: #ff3355; }

  .id-stats {
    display: grid;
    margin: 0.5rem 0 0;
    gap: 0.15rem;
    font-size: 0.75rem;
  }

  .id-stats div {
    display: flex;
    justify-content: space-between;
    border-block-end: 1px dashed rgba(243, 230, 0, 0.25);
  }

  .id-stats dt { color: #a4a4b3; }
  .id-stats dd { margin: 0; color: #ececf1; }

  .id-location {
    display: flex;
    margin-block-start: 0.5rem;
    align-items: center;
    gap: 0.3rem;
    color: #a4a4b3;
    font-size: 0.75rem;
  }

  .barcode {
    height: 1.4rem;
    margin-block-start: 0.75rem;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 4px, currentColor 4px 5px, transparent 5px 8px, currentColor 8px 11px, transparent 11px 13px);
    opacity: 0.85;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .wide { grid-column: 1 / -1; }

  .project-preview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .panel-label h2 {
    font: inherit;
    letter-spacing: inherit;
  }

  .project-preview h3, .skills h3 {
    color: var(--panel-title);
    font-family: inherit;
    font-size: 1rem;
  }

  .project-preview p {
    margin-block: 0.35rem 0.75rem;
    color: var(--panel-muted);
    font-size: 0.9rem;
  }

  .skills { display: grid; gap: 1rem; }
  .skills h3 { margin-block-end: 0.5rem; font-size: 0.9rem; }

  .friend-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
    list-style: none;
  }

  .friend-list a {
    display: flex;
    padding: 0.6rem 0.75rem;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    color: var(--panel-title);
    background: var(--panel-raised);
    font-weight: 650;
    text-decoration: none;
  }

  .friend-list a:hover { color: #0a0a0f; background: var(--yellow); }

  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; gap: 2rem; padding-block: 0.75rem 1.75rem; }
    .id-card {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: 1rem;
    }
    .id-photo { grid-row: span 3; align-self: start; }
    .id-name { margin-block-start: 0; }
    .barcode { grid-column: 1 / -1; }
    .home-grid, .project-preview { grid-template-columns: 1fr; }
  }
</style>
