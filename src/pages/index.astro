---
import { getCollection } from 'astro:content';

import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';

const [profile] = await getCollection('profile');
const posts = getPublishedPosts(await getCollection('posts'));
const projects = (await getCollection('projects')).toSorted(
  (left, right) => right.data.order - left.data.order,
);
const featuredPosts = posts.filter(({ data }) => data.featured).slice(0, 4);
const visiblePosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, 4);
const featuredProjects = projects.filter(({ data }) => data.featured).slice(0, 2);
---

<BaseLayout title={profile.data.name} description={profile.data.tagline}>
  <section class="hero page-shell" aria-labelledby="profile-name">
    <img class="avatar" src={profile.data.avatar} alt={`${profile.data.name} 的头像`} width="112" height="112" />
    <div class="hero-copy">
      <p class="eyebrow">Personal notes · Since 2026</p>
      <h1 id="profile-name">{profile.data.name}</h1>
      <p class="tagline">{profile.data.tagline}</p>
      <div class="hero-links">
        {
          profile.data.location && (
            <span>
              <Icon name="map" />
              {profile.data.location}
            </span>
          )
        }
        {
          profile.data.socials.map((social) => (
            <a href={social.url} target="_blank" rel="me noopener noreferrer">
              {social.label === 'GitHub' && <Icon name="github" />}
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="page-shell">
    <section class="section section-grid" aria-labelledby="about-heading">
      <h2 class="section-label" id="about-heading">关于</h2>
      <div class="section-content prose-intro">
        {profile.data.bio.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href="/about">了解更多 <Icon name="arrow" /></a>
      </div>
    </section>

    <section class="section section-grid" aria-labelledby="posts-heading">
      <h2 class="section-label" id="posts-heading">近期文章</h2>
      <div class="section-content">
        <PostList posts={visiblePosts} compact />
        <a class="text-link" href="/blog">查看全部文章 <Icon name="arrow" /></a>
      </div>
    </section>

    <section class="section section-grid" aria-labelledby="projects-heading">
      <h2 class="section-label" id="projects-heading">项目</h2>
      <div class="section-content project-preview">
        {
          featuredProjects.map((project, index) => (
            <article>
              <p class="project-index">{String(index + 1).padStart(2, '0')}</p>
              <div>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <ul aria-label="技术栈">
                  {project.data.stack.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
        <a class="text-link" href="/projects">查看全部项目 <Icon name="arrow" /></a>
      </div>
    </section>

    <section class="section section-grid" aria-labelledby="skills-heading">
      <h2 class="section-label" id="skills-heading">技能与工具</h2>
      <div class="section-content skills-grid">
        {
          profile.data.skills.map((group) => (
            <section>
              <h3>{group.category}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: 25rem;
    padding-block: 6rem 5rem;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }
  .avatar {
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--line);
    border-radius: 1.75rem;
    background: var(--paper-soft);
    box-shadow: var(--shadow);
  }
  .eyebrow {
    margin-block-end: 0.5rem;
    color: var(--warm);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  h1 { font-size: clamp(2.75rem, 8vw, 5rem); letter-spacing: -0.055em; }
  .tagline {
    margin-block-start: 0.5rem;
    color: var(--text-muted);
    font-family: ui-serif, "Songti SC", serif;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .hero-links, .hero-links a, .hero-links span { display: flex; align-items: center; }
  .hero-links { margin-block-start: 1.25rem; flex-wrap: wrap; gap: 1rem; }
  .hero-links a, .hero-links span {
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .prose-intro { max-width: 42rem; }
  .prose-intro p + p { margin-block-start: 0.875rem; }
  .project-preview article {
    display: grid;
    padding-block: 1.5rem;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    border-block-start: 1px solid var(--line);
  }
  .project-index { color: var(--warm); font-family: ui-monospace, monospace; font-size: 0.75rem; }
  .project-preview h3, .skills-grid h3 { font-family: inherit; font-size: 1rem; }
  .project-preview article p:not(.project-index) { margin-block-start: 0.375rem; color: var(--text-muted); }
  .project-preview ul, .skills-grid ul {
    display: flex;
    margin: 0.75rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }
  .project-preview li, .skills-grid li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .skills-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  @media (max-width: 44rem) {
    .hero { min-height: auto; padding-block: 4rem; grid-template-columns: 1fr; gap: 1.5rem; }
    .avatar { width: 5.5rem; height: 5.5rem; }
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
