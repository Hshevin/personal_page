---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingMinutes, getPublishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('posts'));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  dateStyle: 'long',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  article
>
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href="/blog">← 返回文章列表</a>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>
          {dateFormatter.format(post.data.publishedAt)}
        </time>
        <span>{estimateReadingMinutes(post.body ?? '')} 分钟阅读</span>
      </div>
      <ul class="tag-row" aria-label="文章标签">
        {
          post.data.tags.map((tag) => (
            <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>
          ))
        }
      </ul>
    </header>

    <div class="article-grid">
      {
        toc.length > 0 && (
          <aside aria-labelledby="toc-heading">
            <h2 id="toc-heading">目录</h2>
            <ol>
              {toc.map((heading) => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell {
    width: min(calc(100% - 2rem), 64rem);
    margin-inline: auto;
  }

  .article-header {
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding-block: 4.5rem 3rem;
    border-block-end: 1px solid var(--line);
  }

  .back-link {
    display: inline-block;
    margin-block-end: 1.5rem;
    color: var(--text-muted);
    font-size: 0.825rem;
    text-decoration: none;
  }

  h1 {
    font-size: clamp(2.35rem, 6vw, 4rem);
    letter-spacing: -0.045em;
  }

  .article-header > p {
    margin-block-start: 1rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .article-meta {
    display: flex;
    margin-block-start: 1.5rem;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.825rem;
  }

  .tag-row {
    display: flex;
    margin: 0.75rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
  }

  .tag-row a {
    color: var(--accent-strong);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .article-grid {
    display: grid;
    padding-block: 3rem 5rem;
    grid-template-columns: 10rem minmax(0, var(--content-width));
    justify-content: center;
    gap: 3rem;
  }

  aside {
    position: sticky;
    top: 2rem;
    height: max-content;
    padding-block-start: 0.4rem;
  }

  aside h2 {
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  aside ol {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  aside li + li {
    margin-block-start: 0.4rem;
  }

  aside li.nested {
    padding-inline-start: 0.75rem;
  }

  aside a {
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .prose {
    min-width: 0;
    font-size: 1.025rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 2rem;
  }

  .prose :global(h2) {
    margin-block: 3rem 1rem;
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    margin-block: 2rem 0.75rem;
    font-size: 1.3rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-block: 1.125rem;
  }

  .prose :global(img) {
    height: auto;
    margin-block: 2rem;
    border-radius: var(--radius-sm);
  }

  .prose :global(pre) {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.125rem 0.35rem;
    border-radius: 0.25rem;
    background: var(--surface-raised);
    font-size: 0.9em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--accent);
    color: var(--text-muted);
  }

  .prose :global(a) {
    color: var(--accent-strong);
  }

  @media (max-width: 56rem) {
    .article-grid {
      grid-template-columns: minmax(0, var(--content-width));
    }

    aside {
      position: static;
      padding-block-end: 1.5rem;
      border-block-end: 1px solid var(--line-soft);
    }
  }
</style>
