---
import { getCollection } from 'astro:content';

import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/content';

const posts = getPublishedPosts(await getCollection('posts'));
const tags = getTagCounts(posts);
---

<BaseLayout title="文章" description="学习笔记、项目复盘，还有一些想慢慢弄明白的事。">
  <PageHeader eyebrow={`共 ${posts.length} 篇`} title="文章" description="学习笔记、项目复盘，还有一些想慢慢弄明白的事。" />

  <div class="blog-layout narrow-shell">
    <section class="panel" aria-labelledby="all-posts-heading">
      <h2 id="all-posts-heading" class="visually-hidden">全部文章</h2>
      <PostList posts={posts} />
    </section>

    <aside class="panel panel-red" aria-labelledby="tag-heading">
      <h2 class="panel-label" id="tag-heading">标签</h2>
      <ul>
        {
          tags.map((tag) => (
            <li>
              <a href={`/tags/${encodeURIComponent(tag.name)}/`}>
                <span>{tag.name}</span>
                <small>{tag.count}</small>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="archive-link mono" href="/tags">&gt; 全部标签</a>
      <a class="archive-link mono" href="/archives">&gt; 按年份归档</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    align-items: start;
    gap: 1rem;
  }

  .blog-layout > section { padding-inline: 0.75rem; }

  aside ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  aside li + li { margin-block-start: 0.35rem; }

  aside li a {
    display: flex;
    justify-content: space-between;
    color: var(--panel-ink);
    font-size: 0.875rem;
    text-decoration: none;
  }

  aside li a:hover { color: var(--yellow); }

  aside small {
    color: var(--red);
    font-family: var(--font-mono);
  }

  .archive-link {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--cyan);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .archive-link:hover { color: var(--yellow); }

  @media (max-width: 48rem) {
    .blog-layout { grid-template-columns: 1fr; }
  }
</style>
