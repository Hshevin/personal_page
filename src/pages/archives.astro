---
import { getCollection, type CollectionEntry } from 'astro:content';

import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';

const posts = getPublishedPosts(await getCollection('posts'));
const grouped = Map.groupBy(posts, ({ data }) => data.publishedAt.getFullYear());
const years = [...grouped.keys()].toSorted((left, right) => right - left);
const formatDate = (post: CollectionEntry<'posts'>) =>
  new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(
    post.data.publishedAt,
  );
---

<BaseLayout title="归档" description="按时间回看全部文章。">
  <PageHeader eyebrow={`${posts.length} 篇记录`} title="归档" description="时间会把零散的记录连接成一条能够回看的路径。" />
  <div class="archive narrow-shell">
    {
      years.map((year) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ol>
            {grouped.get(year)?.map((post) => (
              <li>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post)}</time>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .archive {
    padding-block: 3rem 5rem;
  }

  section {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  section + section {
    margin-block-start: 3rem;
  }

  h2 {
    color: var(--warm);
    font-family: ui-monospace, monospace;
    font-size: 1rem;
  }

  ol {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line);
    list-style: none;
  }

  li {
    display: grid;
    padding-block: 0.875rem;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    border-block-end: 1px solid var(--line-soft);
  }

  time {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  a {
    text-decoration: none;
  }

  @media (max-width: 36rem) {
    section {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
