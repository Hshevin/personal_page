---
import { getCollection, type CollectionEntry } from 'astro:content';

import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/content';

const posts = getPublishedPosts(await getCollection('posts'));
const grouped = Map.groupBy(posts, ({ data }) => data.publishedAt.getFullYear());
const years = [...grouped.keys()].toSorted((left, right) => right - left);
const formatDate = (post: CollectionEntry<'posts'>) =>
  new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(
    post.data.publishedAt,
  );
---

<BaseLayout title="归档" description="按年份排好的全部文章，方便从头翻一遍。">
  <PageHeader eyebrow={`共 ${posts.length} 篇`} title="归档" description="按年份排好的全部文章，方便从头翻一遍。" />
  <div class="archive narrow-shell">
    {
      years.map((year) => (
        <section class="panel" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ol>
            {grouped.get(year)?.map((post) => (
              <li>
                <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post)}</time>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .archive {
    display: grid;
    gap: 1rem;
  }

  section {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  h2 {
    color: var(--yellow);
    font-size: 1.75rem;
    font-style: italic;
    line-height: 1;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    padding-block: 0.6rem;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    border-block-end: 1px dashed var(--panel-line);
  }

  li:last-child { border-block-end: 0; }

  time {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  a {
    color: var(--panel-title);
    text-decoration: none;
  }

  a:hover { color: var(--yellow); text-decoration: underline; }

  @media (max-width: 36rem) {
    section {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
