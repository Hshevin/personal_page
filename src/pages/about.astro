---
import { getCollection } from 'astro:content';

import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const [profile] = await getCollection('profile');
---

<BaseLayout title="关于" description={`关于 ${profile.data.name}，以及这个站点是怎么搭起来的。`}>
  <PageHeader eyebrow="档案" title="关于" description={profile.data.tagline} />

  <div class="about narrow-shell" data-pagefind-body>
    <section class="intro panel" aria-labelledby="about-me-heading">
      <img class="cut" src={profile.data.avatar} alt={`${profile.data.name} 的头像`} width="96" height="96" />
      <div>
        <h2 id="about-me-heading">{profile.data.name}</h2>
        {profile.data.bio.map((paragraph) => <p>{paragraph}</p>)}
        <ul class="socials" aria-label="社交链接">
          {
            profile.data.socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="me noopener noreferrer">
                  {social.label} <Icon name="external" size={15} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      profile.data.education.length > 0 && (
        <section class="panel panel-yellow" aria-labelledby="education-heading">
          <h2 class="panel-label" id="education-heading">教育经历</h2>
          <ol class="timeline">
            {profile.data.education.map((item) => (
              <li>
                <span>{item.period}</span>
                <div>
                  <h3>{item.institution}</h3>
                  <p>{item.program}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="panel panel-red" aria-labelledby="skills-heading">
      <h2 class="panel-label" id="skills-heading">在学在用</h2>
      <div class="skill-groups">
        {
          profile.data.skills.map((group) => (
            <section>
              <h3>{group.category}</h3>
              <ul class="chip-list">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="panel" aria-labelledby="site-heading">
      <h2 class="panel-label" id="site-heading">关于这个站点</h2>
      <div class="site-copy">
        <p>这是一个轻量的静态网站：文章和资料都以纯文本保存，每次修改都有记录，没有后台，也不收集访客信息。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 1rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
  }

  .intro img {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    background: var(--yellow);
  }

  .intro h2 {
    color: var(--panel-title);
    font-size: 1.6rem;
  }

  .intro p,
  .site-copy p {
    margin-block-start: 0.6rem;
    color: var(--panel-ink);
  }

  .socials {
    display: flex;
    margin: 1rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .socials a:hover { color: var(--yellow); }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
  }

  .timeline li + li { margin-block-start: 1rem; }

  .timeline span {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .timeline h3 {
    color: var(--panel-title);
    font-family: inherit;
    font-size: 1rem;
  }

  .timeline p { color: var(--panel-muted); }

  .skill-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skill-groups h3 {
    margin-block-end: 0.5rem;
    color: var(--panel-title);
    font-family: inherit;
    font-size: 0.9rem;
  }

  .site-copy p:first-child { margin-block-start: 0; }

  @media (max-width: 40rem) {
    .intro,
    .skill-groups,
    .timeline li {
      grid-template-columns: 1fr;
    }

    .timeline li { gap: 0.25rem; }

    .intro img {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
