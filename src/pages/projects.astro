---
import { getCollection } from 'astro:content';

import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).toSorted(
  (left, right) => right.data.order - left.data.order,
);
const [profile] = await getCollection('profile');
const github = profile.data.socials.find(({ label }) => label === 'GitHub');
---

<BaseLayout title="项目" description="做过和正在做的小东西。">
  <PageHeader
    eyebrow={projects.length > 0 ? `共 ${projects.length} 个` : '建设中'}
    title="项目"
    description="把想法做成能跑、能用、还能接着改的东西。"
  />
  <div class="projects narrow-shell" data-pagefind-body={projects.length > 0 ? '' : undefined}>
    {
      projects.length > 0 ? (
        projects.map((project, index) => (
          <article class:list={['panel', { 'panel-yellow': project.data.featured }]}>
            <p class="panel-label">
              <span>[{String(index + 1).padStart(2, '0')}]</span>
              {project.data.featured && <span class="featured">精选</span>}
            </p>
            <h2>{project.data.title}</h2>
            <p class="summary">{project.data.summary}</p>
            <ul class="chip-list" aria-label={`${project.data.title} 技术栈`}>
              {project.data.stack.map((item) => <li>{item}</li>)}
            </ul>
            {project.data.links.length > 0 && (
              <ul class="project-links" aria-label={`${project.data.title} 相关链接`}>
                {project.data.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label} <Icon name="external" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      ) : (
        <div class="panel empty" role="status">
          <p class="panel-label">// 暂无项目</p>
          <p>项目还在整理中，准备好就放上来。</p>
          <p>先去看看<a href="/blog">文章</a>{github && <>，或者到 <a href={github.url} target="_blank" rel="noopener noreferrer">GitHub</a> 翻翻代码</>}。</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: 1rem;
  }

  .featured {
    color: var(--yellow);
  }

  h2 {
    color: var(--panel-title);
    font-size: 1.75rem;
  }

  .summary {
    margin-block: 0.5rem 1rem;
    color: var(--panel-muted);
  }

  .project-links {
    display: flex;
    margin: 1.25rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .project-links a:hover { color: var(--yellow); }

  .empty p:not(.panel-label) { color: var(--panel-ink); }
  .empty p + p { margin-block-start: 0.35rem; }

  .empty a {
    color: var(--yellow);
    font-weight: 700;
  }
</style>
