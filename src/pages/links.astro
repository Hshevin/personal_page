---
import { getCollection } from 'astro:content';

import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const links = (await getCollection('links')).toSorted(
  (left, right) => right.data.order - left.data.order,
);
const grouped = [...Map.groupBy(links, ({ data }) => data.category)];
const showCategory = grouped.length > 1;
---

<BaseLayout title="友链" description="朋友们的小站，常来串门。">
  <PageHeader eyebrow={`共 ${links.length} 个站点`} title="友链" description="朋友们的小站，常来串门。" />
  <div class="link-groups narrow-shell">
    {
      grouped.map(([category, entries], groupIndex) => (
        <section aria-label={showCategory ? undefined : category} aria-labelledby={showCategory ? `category-${groupIndex}` : undefined}>
          {showCategory && <h2 class="kicker" id={`category-${groupIndex}`}>// {category}</h2>}
          <div class="link-grid">
            {entries.map((entry) => (
              <a class="link-card" href={entry.data.url} target="_blank" rel="noopener noreferrer">
                <span class="avatar" aria-hidden="true">
                  <span>{entry.data.name.slice(0, 1)}</span>
                  <img src={entry.data.avatar} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />
                </span>
                <span class="copy">
                  <strong>{entry.data.name}</strong>
                  <span>{entry.data.description}</span>
                </span>
                <Icon name="external" size={15} />
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  section + section {
    margin-block-start: 2.5rem;
  }

  section > h2 {
    margin-block-end: 0.75rem;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .link-card {
    display: grid;
    padding: 1rem;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.875rem;
    border: 1px solid var(--panel-line);
    color: var(--panel-ink);
    background: var(--panel);
    text-decoration: none;
    transition: transform 140ms ease, border-color 140ms ease;
  }

  .link-card:hover {
    border-color: var(--cyan);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--red);
  }

  .avatar {
    position: relative;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    color: #0a0a0f;
    background: var(--yellow);
    font-weight: 800;
    clip-path: polygon(0 0, 100% 0, 100% 75%, 75% 100%, 0 100%);
  }

  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .copy {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
  }

  strong {
    color: var(--panel-title);
    font-size: 0.95rem;
  }

  .copy > span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--panel-muted);
    font-size: 0.8rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .link-card > :global(svg) { color: var(--cyan); }

  @media (max-width: 42rem) {
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
